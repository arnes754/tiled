# Local development needs none of these set. Copy to .env only when you
# start using the optional pieces.

# Postgres (docker-compose brings one up on this URL)
DATABASE_URL=postgresql://tilevis:tilevis@localhost:5432/tilevis

# Queue (Valkey - BSD fork of Redis)
REDIS_URL=redis://localhost:6379/0

# Where uploads and renders live in dev
DATA_DIR=./data

# Optional generative finish pass. Leave blank to disable it entirely -
# the geometric render is the product, this is polish.
IMAGE_EDIT_PROVIDER=
IMAGE_EDIT_API_KEY=

# Perception models. cpu | mps | cuda
TORCH_DEVICE=mps
SEGMENTATION_MODEL=
DEPTH_MODEL=depth-anything/DA3-BASE
